# RecoverIQ Environment Configuration Example

# Backend API Settings
PORT=8000
HOST=0.0.0.0
ENV=development

# Database Settings
DATABASE_URL=sqlite:///./recoveriq.db

# ML Settings
SEED=42
SYNTHETIC_DATA_SIZE=10000

# Merchant Policy Defaults
DEFAULT_MAX_RETRIES=3
DEFAULT_MIN_PROBABILITY=0.15
DEFAULT_MIN_CONFIDENCE=0.60
DEFAULT_HIGH_VALUE_THRESHOLD=10000.0

# Razorpay Test Credentials (UPDATE THESE WITH YOUR ACTUAL TEST KEYS)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE

